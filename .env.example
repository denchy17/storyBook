# Database — a plain SQLite file owned by the app (path is relative to prisma/).
DATABASE_URL="file:./dev.db"

# Where images, narration and uploaded photos are written (relative to the repo root).
STORAGE_DIR="./storage"

# Signs the session JWTs. Generate one with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
AUTH_SECRET="change-me"

