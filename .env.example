# Database — hosted Postgres (Supabase). Copy both strings from the dashboard:
# DATABASE_URL is the pooled one (host contains "-pooler"), used at runtime;
# DIRECT_URL is the unpooled one, which `prisma migrate` needs.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Local-only: where images, narration and uploads are written during `npm run dev`
# (relative to the repo root). On Netlify this is ignored — the deployed app uses
# Netlify Blobs, which needs no configuration.
STORAGE_DIR="./storage"

# Signs the session JWTs. Generate one with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
AUTH_SECRET="change-me"

# AI providers
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
